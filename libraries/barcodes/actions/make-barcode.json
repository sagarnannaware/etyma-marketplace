      "type": "CallFunction",
      "position": {
        "x": 0,
        "y": 120
      },
      "data": {
        "packageName": "bwip-js",
        "exportName": "toBuffer",
        "args": "[\"{{= ({ bcid: symbology || 'code128', text: text, scale: 3, height: 10, includetext: true }) }}\"]",
