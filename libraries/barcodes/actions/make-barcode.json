{
  "name": "Make Barcode",
  "description": "Render a barcode as a PNG data URL for a product label, a shipping label, an asset tag, a pick list or an inventory sheet. The symbology is Code 128 unless given: code128, ean13, upca, code39, datamatrix, pdf417.",
  "scope": "server",
  "parameters": [
    {
      "id": "j-oA_E3aXkgB",
      "name": "text",
      "type": "Text"
    },
    {
      "id": "wt7Vni35U76m",
      "name": "symbology",
      "type": "Text"
    }
  ],
  "returnType": "Text",
  "isPublic": true,
  "nodes": [
