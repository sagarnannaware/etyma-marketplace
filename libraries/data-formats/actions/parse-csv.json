{
  "name": "Parse CSV",
  "description": "Records from CSV text — the price list a supplier emails, an export from another system, a bank statement — one object per row keyed by the header line, numbers as numbers. delimiter is detected unless given (',' ';' or a tab).",
  "scope": "server",
  "parameters": [
    {
      "id": "Ag2tQGYnczuC",
      "name": "text",
      "type": "Text"
